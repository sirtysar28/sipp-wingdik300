<script>
const labels = @json($chartLabels);
const datasets = [
  {label:'Total',data:@json($chartTotal),borderColor:'#4f46e5',backgroundColor:'rgba(79,70,229,.08)',tension:.3,pointRadius:4,fill:true},
  {label:'Akademik',data:@json($chartAkd),borderColor:'#059669',backgroundColor:'transparent',tension:.3,pointRadius:3},
  {label:'Fisik',data:@json($chartFis),borderColor:'#d97706',backgroundColor:'transparent',tension:.3,pointRadius:3},
  {label:'Sikap',data:@json($chartSik),borderColor:'#dc2626',backgroundColor:'transparent',tension:.3,pointRadius:3},
  {label:'Kepemimpinan',data:@json($chartKep),borderColor:'#7c3aed',backgroundColor:'transparent',tension:.3,pointRadius:3},
];
const baseOpts = {
  responsive:true,maintainAspectRatio:false,
  plugins:{legend:{display:false},tooltip:{mode:'index',intersect:false}},
  scales:{
    x:{grid:{color:'rgba(0,0,0,.05)'},ticks:{color:'#888',font:{size:11}}},
    y:{grid:{color:'rgba(0,0,0,.05)'},ticks:{color:'#888',font:{size:11}},min:0,max:100}
  }
};
const ctxLine = document.getElementById('chart-line').getContext('2d');
const ctxBar  = document.getElementById('chart-bar').getContext('2d');
new Chart(ctxLine, {type:'line',data:{labels,datasets},options:baseOpts});
new Chart(ctxBar,  {type:'bar', data:{labels,datasets:[{...datasets[0],backgroundColor:'#818cf8',borderRadius:5,borderSkipped:false,fill:false}]},options:baseOpts});

function switchChart(t) {
  document.getElementById('chart-line').style.display = t==='line'?'block':'none';
  document.getElementById('chart-bar').style.display  = t==='bar' ?'block':'none';
  document.getElementById('btn-line').className = t==='line'?'btn btn-sm btn-primary':'btn btn-sm btn-outline';
  document.getElementById('btn-bar').className  = t==='bar' ?'btn btn-sm btn-primary':'btn btn-sm btn-outline';
}
</script>
